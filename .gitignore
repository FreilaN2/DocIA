# =====================
# PYTHON — Backend
# =====================

# Entorno virtual
venv/
env/
.venv/

# Caché de Python
__pycache__/
*.py[cod]
*.pyo

# Distribuciones / builds
build/
*.egg-info/

# Variables de entorno y claves secretas (¡no subir al repositorio!)
.env
.env.*
*.key
.jwt_secret.key

# =====================
# NODE — Frontend
# =====================

# Dependencias
node_modules/

# Build de producción — INCLUIDO para Railway (descomentar si solo usas cPanel)
# frontend/dist/
frontend/.vite/

# Logs de npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =====================
# PROYECTO — DocAI
# =====================

# Archivos subidos por usuarios
backend/uploads/

# Archivos procesados/generados
backend/processed/

# Documentos de prueba generados localmente
backend/*.docx

